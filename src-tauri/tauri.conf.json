{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "QuotaShift",
  "version": "1.1.1",
  "identifier": "com.thelongride.quotashift",
  "build": {
    "beforeDevCommand": "pnpm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "QuotaShift",
        "width": 960,
        "height": 700,
        "minWidth": 912,
        "minHeight": 520,
        "decorations": false,
        "shadow": true,
        "transparent": false,
        "visible": true,
        "resizable": true,
        "skipTaskbar": false,
        "alwaysOnTop": false
      },
      {
        "label": "overlay",
        "title": "QuotaShift Overlay",
        "url": "index.html?window=overlay",
        "width": 340,
        "height": 80,
        "decorations": false,
        "shadow": false,
        "transparent": true,
        "visible": false,
        "resizable": false,
        "skipTaskbar": true,
        "alwaysOnTop": true
      },
      {
        "label": "overlay-tooltip",
        "title": "QuotaShift Overlay Tooltip",
        "url": "index.html?window=overlay-tooltip",
        "width": 340,
        "height": 38,
        "decorations": false,
        "shadow": false,
        "transparent": true,
        "visible": false,
        "resizable": false,
        "skipTaskbar": true,
        "alwaysOnTop": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "the-long-ride",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "template": "installer.nsi",
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico"
      }
    }
  }
}
