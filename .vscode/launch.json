{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "chrome",
      "request": "attach",
      "name": "Debug QuotaShift (Tauri)",
      "port": 9222,
      "webRoot": "${workspaceFolder}/src",
      "timeout": 30000,
      "preLaunchTask": "tauri dev"
    },
    {
      "name": "Launch QuotaShift Web Page",
      "type": "node-terminal",
      "request": "launch",
      "command": "pnpm exec vite --config vite.site.config.ts --open",
      "cwd": "${workspaceFolder}"
    }
  ]
}
